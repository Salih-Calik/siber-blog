---
import BaseHead from '../../components/BaseHead.astro';
import Sidebar from '../../components/Sidebar.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!doctype html>
<html lang="tr">
	<head>
		<BaseHead title={`Teknik Makaleler - ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<div class="app-wrapper">
			<Sidebar />
			
			<main class="page-content">
				<h1>Teknik Makaleler</h1>
				<p class="blog-intro">
					Ofansif güvenlik, sızma testleri, L2/L3 ağ mimarileri ve tersine mühendislik üzerine detaylı rehberler.
				</p>

				<section class="posts-list">
					{
						posts.map((post) => (
							<article class="card-box post-card">
								<a href={`/blog/${post.slug}/`}>
									{post.data.heroImage && (
										<img src={post.data.heroImage} alt={post.data.title} class="post-hero" />
									)}
									<div class="post-info">
										<p class="post-date">
											<FormattedDate date={post.data.pubDate} />
										</p>
										<h3 class="post-title">{post.data.title}</h3>
										<p class="post-desc">{post.data.description}</p>
									</div>
								</a>
							</article>
						))
					}
				</section>
			</main>
		</div>

		<style>
			.blog-intro {
				font-size: 1.1rem;
				margin: 0.5rem 0 2rem 0;
			}
			.posts-list {
				display: flex;
				flex-direction: column;
				gap: 1.25rem;
			}
			.post-card {
				transition: transform 0.2s ease, border-color 0.2s ease;
				padding: 0 !important;
				overflow: hidden;
			}
			.post-card:hover {
				transform: translateY(-2px);
				border-color: var(--accent-blue) !important;
			}
			.post-card a {
				display: block;
				padding: 1.25rem;
				text-decoration: none;
			}
			.post-hero {
				width: 100%;
				max-height: 220px;
				object-fit: cover !important;
				margin-bottom: 1rem;
			}
			.post-date {
				font-size: 0.85rem;
				color: var(--accent-blue) !important;
				font-weight: 700;
				margin-bottom: 0.3rem;
			}
			.post-title {
				font-size: 1.3rem;
				color: #ffffff !important;
				margin-bottom: 0.5rem;
			}
			.post-desc {
				font-size: 0.95rem;
				color: #ffffff !important;
				opacity: 0.9;
				margin-bottom: 0;
			}
		</style>
	</body>
</html>