---
import BaseHead from '../../components/BaseHead.astro';
import Sidebar from '../../components/Sidebar.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!doctype html>
<html lang="tr">
	<head>
		<BaseHead title={`Teknik Makaleler - ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<div class="app-wrapper">
			<Sidebar />
			
			<main class="page-content">
				<h1>Teknik Makaleler</h1>
				<p class="blog-intro">
					Ofansif güvenlik, sızma testleri, L2/L3 ağ mimarileri ve tersine mühendislik üzerine detaylı rehberler ve dökümanlar.
				</p>

				<div class="posts-container">
					{
						posts.map((post) => (
							<article class="card-box post-card">
								<a href={`/blog/${post.slug}/`}>
									{post.data.heroImage && (
										<img src={post.data.heroImage} alt={post.data.title} class="post-hero" />
									)}
									<div class="post-info">
										<span class="post-date">
											{new Date(post.data.pubDate).toLocaleDateString('tr-TR', {
												year: 'numeric',
												month: 'long',
												day: 'numeric',
											})}
										</span>
										<h3>{post.data.title}</h3>
										<p>{post.data.description}</p>
									</div>
								</a>
							</article>
						))
					}
				</div>
			</main>
		</div>

		<style>
			.blog-intro {
				font-size: 1.1rem;
				margin: 0.5rem 0 2rem 0;
			}
			.posts-container {
				display: flex;
				flex-direction: column;
				gap: 1.5rem;
			}
			.post-card {
				padding: 0 !important;
				overflow: hidden;
				transition: transform 0.2s ease, border-color 0.2s ease;
			}
			.post-card:hover {
				transform: translateY(-2px);
				border-color: var(--accent-blue) !important;
			}
			.post-card a {
				display: block;
				padding: 1.5rem;
				text-decoration: none !important;
			}
			.post-hero {
				width: 100%;
				max-height: 240px;
				object-fit: cover !important;
				margin-bottom: 1rem;
				border-radius: 6px;
			}
			.post-date {
				font-size: 0.85rem;
				color: var(--accent-blue) !important;
				font-weight: 700;
				display: block;
				margin-bottom: 0.4rem;
				text-transform: uppercase;
				letter-spacing: 0.05em;
			}
			.post-card h3 {
				font-size: 1.35rem;
				color: #ffffff !important;
				margin-bottom: 0.5rem;
			}
			.post-card p {
				font-size: 0.98rem;
				color: #ffffff !important;
				opacity: 0.9;
				margin-bottom: 0;
			}
		</style>
	</body>
</html>