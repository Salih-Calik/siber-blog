---
import { type CollectionEntry, getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Sidebar from '../../components/Sidebar.astro';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { slug: post.slug },
		props: post,
	}));
}
type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const { Content } = await post.render();

const formattedDate = new Date(post.data.pubDate).toLocaleDateString('tr-TR', {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
});
---

<!doctype html>
<html lang="tr">
	<head>
		<BaseHead title={post.data.title} description={post.data.description} />
	</head>
	<body>
		<div class="app-wrapper">
			<Sidebar />

			<main class="page-content">
				<article class="article-detail">
					{post.data.heroImage && (
						<img src={post.data.heroImage} alt={post.data.title} class="detail-hero" />
					)}
					
					<div class="article-header">
						<span class="article-date">{formattedDate}</span>
						<h1 class="article-title">{post.data.title}</h1>
						<hr class="header-divider" />
					</div>

					<div class="article-body">
						<Content />
					</div>
				</article>
			</main>
		</div>

		<style>
			.detail-hero {
				width: 100%;
				max-height: 380px;
				object-fit: cover !important;
				margin-bottom: 1.5rem;
				border-radius: 8px;
			}
			.article-date {
				font-size: 0.88rem;
				color: var(--accent-blue) !important;
				font-weight: 700;
				display: block;
				margin-bottom: 0.4rem;
				text-transform: uppercase;
				letter-spacing: 0.05em;
			}
			.article-title {
				font-size: 2.2rem;
				color: #ffffff !important;
				margin-bottom: 1rem;
				line-height: 1.3;
			}
			.header-divider {
				border: none;
				border-top: 1px solid var(--border-line);
				margin: 1.5rem 0 2rem 0;
			}
			.article-body {
				line-height: 1.8;
				font-size: 1.05rem;
				color: #ffffff !important;
			}
		</style>
	</body>
</html>