---
// Sidebar Component
---

<!-- Hem Masaüstü Hem Mobilde En Üstte Duran Sabit Bar -->
<header class="top-header">
	<button id="menu-toggle" class="hamburger-btn" type="button" aria-label="Menü">
		<span class="bar"></span>
		<span class="bar"></span>
		<span class="bar"></span>
	</button>
	<span class="header-brand">Siber Vizyon</span>
</header>

<!-- Arka Plan Karartması (Overlay) -->
<div id="sidebar-overlay" class="sidebar-overlay"></div>

<!-- Soldan Kayarak Açılan Yan Panel -->
<aside id="sidebar-container" class="sidebar-container">
	<button id="menu-close" class="close-btn" type="button" aria-label="Kapat">&times;</button>

	<div class="profile-header">
		<a href="/" class="avatar-wrap">
			<img src="/avatar.png" alt="Salih Çalık Fotoğrafı" class="profile-avatar" />
		</a>
		<h2 class="brand-title"><a href="/">Siber Vizyon</a></h2>
		<p class="author-name">Salih Çalık</p>
		<p class="author-badge">Off-Sec & Network Logbook</p>
	</div>

	<nav class="sidebar-menu">
		<a href="/" class="menu-link">
			<span class="icon">🏠</span> Ana Sayfa
		</a>
		<a href="/about" class="menu-link">
			<span class="icon">📰</span> Haberler
		</a>
	</nav>

	<div class="sidebar-bottom">
		<div class="social-group">
			<a href="https://github.com/Salih-Calik" target="_blank" rel="noopener noreferrer">GitHub</a>
			<a href="https://www.instagram.com/root.vesper/" target="_blank" rel="noopener noreferrer">Instagram</a>
		</div>
		<p class="copyright-text">&copy; 2026 Siber Vizyon</p>
	</div>
</aside>

<script is:inline>
	document.addEventListener('DOMContentLoaded', function() {
		var toggle = document.getElementById('menu-toggle');
		var close = document.getElementById('menu-close');
		var sidebar = document.getElementById('sidebar-container');
		var overlay = document.getElementById('sidebar-overlay');

		function openMenu() {
			if (sidebar) sidebar.classList.add('active');
			if (overlay) overlay.classList.add('active');
		}

		function closeMenu() {
			if (sidebar) sidebar.classList.remove('active');
			if (overlay) overlay.classList.remove('active');
		}

		if (toggle) toggle.addEventListener('click', openMenu);
		if (close) close.addEventListener('click', closeMenu);
		if (overlay) overlay.addEventListener('click', closeMenu);
	});
</script>

<style>
	/* Üst Bar (Header) - Hem Masaüstü Hem Mobil */
	.top-header {
		display: flex;
		align-items: center;
		justify-content: center;
		position: sticky;
		top: 0;
		padding: 0.9rem 1.5rem;
		background-color: var(--bg-sidebar);
		border-bottom: 1px solid var(--border-line);
		z-index: 90;
		width: 100%;
	}

	.hamburger-btn {
		position: absolute;
		left: 1.5rem;
		background: none;
		border: none;
		cursor: pointer;
		display: flex;
		flex-direction: column;
		gap: 5px;
		padding: 0.3rem;
		transition: opacity 0.2s ease;
	}

	.hamburger-btn:hover {
		opacity: 0.8;
	}

	.hamburger-btn .bar {
		width: 22px;
		height: 2px;
		background-color: #ffffff;
		border-radius: 2px;
	}

	.header-brand {
		font-size: 1.2rem;
		font-weight: 800;
		color: #ffffff;
		letter-spacing: 0.03em;
	}

	/* Soldan Kayan Panel Stilleri */
	.sidebar-overlay {
		position: fixed;
		top: 0;
		left: 0;
		width: 100vw;
		height: 100vh;
		background-color: rgba(0, 0, 0, 0.75);
		backdrop-filter: blur(4px);
		z-index: 98;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.25s ease;
	}

	.sidebar-overlay.active {
		opacity: 1;
		pointer-events: auto;
	}

	.sidebar-container {
		position: fixed;
		top: 0;
		left: -320px; /* Kapalıyken solda saklanır */
		width: 290px;
		height: 100vh;
		background-color: var(--bg-sidebar);
		border-right: 1px solid var(--border-line);
		padding: 2.5rem 1.5rem;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
		z-index: 99;
		box-shadow: 4px 0 24px rgba(0, 0, 0, 0.6);
	}

	.sidebar-container.active {
		transform: translateX(320px); /* Tıklayınca ekrana kayar */
	}

	.close-btn {
		position: absolute;
		top: 1rem;
		right: 1.2rem;
		background: none;
		border: none;
		color: #ffffff;
		font-size: 2rem;
		line-height: 1;
		cursor: pointer;
		opacity: 0.7;
		transition: opacity 0.2s ease;
	}

	.close-btn:hover {
		opacity: 1;
	}

	/* Profil Bilgileri */
	.profile-header {
		text-align: center;
		margin-top: 1rem;
	}

	.profile-avatar {
		width: 100px;
		height: 100px;
		border-radius: 50%;
		border: 2px solid var(--accent-blue);
		margin-bottom: 1rem;
		object-fit: cover;
		background-color: #000;